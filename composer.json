{
  "name": "zangra/bpost-api-library",
  "type": "library",
  "description": "bpost API library is a PHP library to communicate with the bpost API.",
  "homepage": "https://github.com/Antidot-be/bpost-api-library",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Maxime Lambot",
      "email": "maxime@zangra.com",
      "role": "Developer"
    },
    {
      "name": "Raphaël Pommier",
      "email": "rpommier@antidot.com",
      "role": "Developer"
    },
    {
      "name": "kouinkouin",
      "email": "me@kouinkouin.com",
      "role": "Developer"
    },
    {
      "name": "Tijs Verkoyen",
      "email": "bpost@verkoyen.eu",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1 || ^8.4",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-dom": "*",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "Bpost\\BpostApiClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },

  "config": { "sort-packages": true }
}